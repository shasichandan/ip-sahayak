PROJECT_NAME="IP-SAKTI Sahayak API"
API_V1_PREFIX=/api
DATABASE_URL=postgresql+asyncpg://USER:PASS@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=CHANGE_ME_dev_only
ACCESS_TOKEN_EXPIRE_MINUTES=120
RAG_ENGINE_MODULE=app.services.rag.mock_engine
RAG_ENGINE_CLASS=MockRAGEngine
ML_ENGINE_MODULE=app.services.ml.passthrough
ML_ENGINE_CLASS=PassthroughTranslationEngine
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
RATE_LIMIT_CHAT=20
RATE_LIMIT_WINDOW_SECONDS=60
